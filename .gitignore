# dependencies
node_modules/
# ...but re-include the vendored code-server IDE runtime (committed on purpose)
!.code-server-src/runtime/
!.code-server-src/runtime/**

# build output
dist/
.vite/

# runtime data (SQLite stats DB lives here)
data/
*.sqlite
*.sqlite-shm
*.sqlite-wal

# portable release output
release/

# vendored V8 engine source (native runtime substrate; see .v8-src/README.md)
.v8-src/

# code-server IDE user data (runtime IS committed, including the rebranded
# code-server install — no install step needed on clones or in Docker)
.code-server-src/data/

# env
.env
.env.local
.env.*.local

# logs / os
*.log
npm-debug.log*
.DS_Store
