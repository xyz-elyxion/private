# Build output — generated by build.js (index.html, about.html, api.json, ...)
dist/

# Registry data — users, tokens, and packages written at runtime by server.js
data/

# Installed packages — elyx install <package>
elyx_modules/

# Secrets — never commit tokens
hf-token
.env

# Logs
*.log

# Node (in case any tooling is added later)
node_modules/

# OS / editor junk
.DS_Store
