# dependencies
node_modules/

# build output
dist/
.vite/

# runtime data (SQLite stats DB lives here)
data/
*.sqlite
*.sqlite-shm
*.sqlite-wal

# portable release output
release/

# vendored V8 engine source (native runtime substrate; see .v8-src/README.md)
.v8-src/

# code-server IDE user data (source + runtime are committed, NOT ignored)
.code-server-src/data/
# re-include the vendored runtime's node_modules (the generic node_modules/
# rule above would otherwise exclude the actual code-server package)
!.code-server-src/runtime/
!.code-server-src/runtime/node_modules/
!.code-server-src/runtime/node_modules/**

# env
.env
.env.local
.env.*.local

# logs / os
*.log
npm-debug.log*
.DS_Store
