# dependencies
node_modules/

# build output
dist/
.vite/

# runtime data (SQLite stats DB lives here)
data/
*.sqlite
*.sqlite-shm
*.sqlite-wal

# portable release output
release/

# vendored V8 engine source (native runtime substrate; see .v8-src/README.md)
.v8-src/

# code-server IDE user data (source clone stays committed; the ~400MB runtime
# is installed at Docker build time, see Dockerfile build stage)
.code-server-src/data/
.code-server-src/runtime/

# env
.env
.env.local
.env.*.local

# logs / os
*.log
npm-debug.log*
.DS_Store
